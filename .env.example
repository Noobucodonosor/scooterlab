# ScooterLab — Variabili d'Ambiente Locali (Template)
# Copia questo file in `.env` (escluso da Git) e inserisci valori reali solo in locale.

# Endpoint & Sicurezza Ingest Server (ADR-0003)
SCOOTERLAB_INGEST_HOST=127.0.0.1
SCOOTERLAB_INGEST_PORT=8500
SCOOTERLAB_BEARER_TOKEN=replace-with-strong-random-token-32bytes

# TLS opzionale (per HTTPS diretto senza reverse proxy)
SCOOTERLAB_TLS_CERT=
SCOOTERLAB_TLS_KEY=

# Directory locali (sempre escluse da Git)
SCOOTERLAB_SESSIONS_DIR=tools/sessions
SCOOTERLAB_REPORTS_DIR=tools/reports

# Broker MQTT / Mini-UNS opzionale (ADR-0004)
SCOOTERLAB_MQTT_HOST=127.0.0.1
SCOOTERLAB_MQTT_PORT=8883
SCOOTERLAB_MQTT_USER=
SCOOTERLAB_MQTT_PASS=
SCOOTERLAB_MQTT_TOPIC_PREFIX=scooterlab/symphony200

# Chilometraggio iniziale veicolo per calcolo tagliandi SYM (ADR-0004)
SCOOTERLAB_ODOMETER_KM=0
