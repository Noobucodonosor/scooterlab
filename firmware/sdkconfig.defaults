# ScooterLab ESP-IDF v6.x Defaults (ADR-0002 & ADR-0003)
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# Sicurezza RED EN 18031 / CRA-ready
CONFIG_NVS_ENCRYPTION=y
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y
CONFIG_BOOTLOADER_APP_ANTI_ROLLBACK=y
CONFIG_ESP_HTTPS_OTA_ALLOW_HTTP=n

# Nota Produzione: abilitare Secure Boot v2 & Flash Encryption solo dopo
# completamento test a banco (eFuse irreversibili):
# CONFIG_SECURE_BOOT_V2_ENABLED=y
# CONFIG_SECURE_FLASH_ENC_ENABLED=y

# Performance & Bus (SPI Smart IMU + microSD, UART GNSS, TWAI CAN)
CONFIG_FREERTOS_HZ=1000
CONFIG_FATFS_LFN_HEAP=y
CONFIG_FATFS_MAX_LFN=64
